{
  "info": {
    "name": "TaskFlow API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "1. Görev Listeleme",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks"
          ]
        }
      }
    },
    {
      "name": "2. Görev Ekleme",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Rapor hazırla\",\n  \"description\": \"Haftalık durum raporu\",\n  \"priority\": \"high\",\n  \"assignee\": \"musa\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "3. Görev Detayı",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tasks/4",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks",
            "4"
          ]
        }
      }
    },
    {
      "name": "4. Görev Güncelleme",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tasks/4",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks",
            "4"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"completed\",\n  \"assignee\": \"ayse\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "5. Görev Silme",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tasks/4",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks",
            "4"
          ]
        }
      }
    },
    {
      "name": "6. Silinen Görev (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tasks/4",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks",
            "4"
          ]
        }
      }
    },
    {
      "name": "7. Geçersiz Veri (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"\",\n  \"priority\": \"urgent\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
}